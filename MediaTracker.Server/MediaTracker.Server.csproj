<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <Version>1.0.0</Version>
        <!-- Bakes icon.ico into Tsundoku.exe; the Windows tray reads the same resource
             through ExtractIconExW when no explicit icon file is found. -->
        <ApplicationIcon>icon.ico</ApplicationIcon>
        <!-- Release on Windows hides the console window (WinExe); Debug and every
             other platform keep a regular console executable. -->
        <OutputType Condition="'$(Configuration)' == 'Release' and '$(OS)' == 'Windows_NT'">WinExe</OutputType>
        <OutputType Condition="'$(Configuration)' != 'Release' or '$(OS)' != 'Windows_NT'">Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
        <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>

        <RuntimeIdentifier Condition="'$(OS)' == 'Windows_NT'">win-x64</RuntimeIdentifier>
        <!-- Only a default: an explicit `-o` / `-p:PublishDir=` on the command
             line must win, otherwise `dotnet publish -o dist/server_build`
             ignores it and splatters the publish output into dist/. -->
        <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\dist\</PublishDir>

        <!-- The single monolithic NativeAOT binary (server + tray + launcher) is Tsundoku. -->
        <AssemblyName>Tsundoku</AssemblyName>
        <RootNamespace>MediaTracker.Server</RootNamespace>

        <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
        <GenerateStaticWebAssetsManifest>false</GenerateStaticWebAssetsManifest>
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>

        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <AnalysisMode>All</AnalysisMode>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Dapper.AOT</InterceptorsNamespaces>
        <AnalysisModePerformance>Recommended</AnalysisModePerformance>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

        <!-- Stage 3 (NativeAOT): surface reflection-based JSON / trim / single-file hazards at build time. -->
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
        <!-- Minimal API Request Delegate Generator: intercepts Map* calls so RequestDelegateFactory
             reflection (IL2026/IL3050 on MapGet/MapPost/...) disappears under AOT. -->
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>

        <!-- IL2104: Serilog 4.3 ships trim-incompatible metadata upstream; nothing to fix on our side
             until the library itself is updated. -->
        <NoWarn>$(NoWarn);NETSDK1194;IL2026;IL3050;IL2104;CA1707;CA1720</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release' and ('$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'linux-x64')">
        <!-- Stage 4 (NativeAOT): fully ahead-of-time compiled binary. Self-contained, single file and
             compression are inherent to AOT publishing; the old PublishSingleFile switches conflict. -->
        <PublishAot>true</PublishAot>
        <StripSymbols>true</StripSymbols>
        <OptimizationPreference>Speed</OptimizationPreference>
        <!-- ilc already parallelizes across all cores by default (no IlcParallelism property
             exists; single-threaded compilation is only forced when IlcSingleThreaded is true). -->
        <IlcSingleThreaded>false</IlcSingleThreaded>
        <!-- Identical method body folding costs minutes of link time for a marginal
             size win; disabling it keeps the NativeAOT compile fast. -->
        <IlcFoldIdenticalMethodBodies>false</IlcFoldIdenticalMethodBodies>

        <DebugType>None</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="bin\**" />
        <Compile Remove="obj\**" />
        <Compile Remove="wwwroot\**" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="appsettings.json" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Update="appsettings.json" CopyToPublishDirectory="Never" />
        <Content Update="web.config" CopyToPublishDirectory="Never" />
        <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Dapper" Version="2.1.66" />
        <PackageReference Include="Dapper.AOT" Version="1.1.0" />
        <PackageReference Include="FluentValidation" Version="12.1.1" />
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="SkiaSharp" Version="2.88.9" />
        <!-- NoDependencies builds libSkiaSharp without fontconfig, so headless CI /
             container images need no extra system packages. -->
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" Condition="'$(RuntimeIdentifier)' == 'linux-x64' or '$(OS)' != 'Windows_NT'" />
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.9" Condition="'$(RuntimeIdentifier)' == 'win-x64' or '$(OS)' == 'Windows_NT'" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
        <PackageReference Include="OpenApiUi" Version="2.0.5" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="MediaTracker.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MediaTracker.Generators\MediaTracker.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- Close any running instance of Tsundoku on Windows before publish so locked files don't fail bundle generation -->
    <Target Name="CloseRunningTsundoku" BeforeTargets="BeforePublish;PrepareForPublish" Condition="'$(OS)' == 'Windows_NT'">
        <Exec Command="taskkill /F /IM Tsundoku.exe 2&gt;nul || exit 0" ContinueOnError="true" IgnoreExitCode="true" />
    </Target>

</Project>
