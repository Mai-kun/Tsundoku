<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <Version>1.0.0</Version>
        <OutputType Condition="'$(OS)' == 'Windows_NT'">WinExe</OutputType>
        <OutputType Condition="'$(OS)' != 'Windows_NT'">Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
        <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>

        <RuntimeIdentifier Condition="'$(OS)' == 'Windows_NT'">win-x64</RuntimeIdentifier>
        <PublishDir>$(MSBuildThisFileDirectory)..\dist\</PublishDir>

        <AssemblyName>Tsundoku</AssemblyName>
        <RootNamespace>MediaTracker.Server</RootNamespace>

        <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
        <GenerateStaticWebAssetsManifest>false</GenerateStaticWebAssetsManifest>
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>

        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <AnalysisMode>All</AnalysisMode>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Dapper.AOT</InterceptorsNamespaces>
        <AnalysisModePerformance>Recommended</AnalysisModePerformance>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

        <!-- Stage 3 (NativeAOT): surface reflection-based JSON / trim / single-file hazards at build time. -->
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
        <!-- Minimal API Request Delegate Generator: intercepts Map* calls so RequestDelegateFactory
             reflection (IL2026/IL3050 on MapGet/MapPost/...) disappears under AOT. -->
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>

        <!-- NuGet audit silenced for ImageSharp, pinned at 3.1.12: the five 2026 GHSA
             advisories (NU1902 medium / NU1903 high) are patched only in 4.1.2, and the
             4.x line refuses to build Release without a Six Labors license key.
             Upgrade path: bump to 4.1.2, take the free community key from
             licensing.sixlabors.com (or a sixlabors.lic file), then drop NU1902/NU1903
             from this list. -->
        <NoWarn>$(NoWarn);NU1902;NU1903;NETSDK1194;IL2026;IL3050</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release' and ('$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'linux-x64')">
        <!-- Stage 4 (NativeAOT): fully ahead-of-time compiled binary. Self-contained, single file and
             compression are inherent to AOT publishing; the old PublishSingleFile switches conflict. -->
        <PublishAot>true</PublishAot>
        <StripSymbols>true</StripSymbols>
        <OptimizationPreference>Speed</OptimizationPreference>

        <DebugType>None</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="bin\**" />
        <Compile Remove="obj\**" />
        <Compile Remove="wwwroot\**" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="appsettings.json" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Update="appsettings.json" CopyToPublishDirectory="Never" />
        <Content Update="web.config" CopyToPublishDirectory="Never" />
        <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Dapper" Version="2.1.66" />
        <PackageReference Include="Dapper.AOT" Version="1.1.0" />
        <PackageReference Include="FluentValidation" Version="12.1.1" />
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
        <PackageReference Include="Photino.NET" Version="4.0.16" />
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
        <PackageReference Include="OpenApiUi" Version="2.0.5" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="MediaTracker.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MediaTracker.Generators\MediaTracker.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- Close any running instance of Tsundoku on Windows before publish so locked files don't fail bundle generation -->
    <Target Name="CloseRunningTsundoku" BeforeTargets="BeforePublish;PrepareForPublish" Condition="'$(OS)' == 'Windows_NT'">
        <Exec Command="taskkill /F /IM Tsundoku.exe 2&gt;nul || exit 0" ContinueOnError="true" IgnoreExitCode="true" />
    </Target>

</Project>
