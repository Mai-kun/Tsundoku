{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.html",
    "checks/**/*.ts",
    "checks/**/*.cjs",
    "public/sw.js",
    "src/shared/utils/reactivityDebug.svelte.ts"
  ],
  "project": [
    "src/**/*.{ts,svelte,css}",
    "checks/**/*.{ts,cjs}"
  ],
  "ignoreDependencies": [
    "@types/pixelmatch",
    "html-validate",
    "stylelint-config-standard",
    "svelte-eslint-parser"
  ],
  "ignoreBinaries": [
    "renice"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "warn"
  }
}
