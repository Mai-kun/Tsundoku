{
  "name": "mediatracker-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "check:cards": "node checks/cards.check.cjs",
    "check:prefetch": "node --experimental-strip-types checks/prefetchCache.check.ts",
    "check:anilist-mapping": "node --experimental-strip-types checks/anilistMapping.check.ts",
    "check:release-dates": "node checks/releaseDates.check.cjs",
    "check:ratings-settled": "node checks/ratingsSettled.check.cjs",
    "check:leading-chars": "node checks/leadingChars.check.cjs",
    "check:visual-qa": "node checks/visualQa.check.cjs",
    "check:nav-overlap": "node checks/navOverlap.check.cjs",
    "check:popover": "node checks/popover.check.cjs",
    "check:history-delete": "node checks/historyDelete.check.cjs",
    "check:achievements-buttons": "node checks/achievementsButtons.check.cjs",
    "check:score-stack": "node checks/scoreStack.check.cjs",
    "check:category-switch": "node checks/categorySwitch.check.cjs",
    "check:tokens": "node checks/tokens.check.cjs",
    "check:jobs": "node checks/jobsQueue.check.cjs",
    "check:seasons": "node checks/seasons.check.cjs",
    "check:related": "node checks/related.check.cjs",
    "check:relink": "node checks/relink.check.cjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.2",
    "daisyui": "^5.7.47",
    "playwright": "^1.63.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "lucide-svelte": "^1.0.1"
  }
}
